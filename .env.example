# ==============================================================================
# n8n Workflow AI Generator - Environment Configuration (.env.example)
# Copy this file to .env and configure your keys. Never commit .env to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Primary LLM Provider: OpenRouter (Four-Key Pool)
# Configure up to 4 OpenRouter keys. Empty keys are safely ignored by the manager.
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY_1=your_openrouter_api_key_1_here
OPENROUTER_API_KEY_2=your_openrouter_api_key_2_here
OPENROUTER_API_KEY_3=your_openrouter_api_key_3_here
OPENROUTER_API_KEY_4=your_openrouter_api_key_4_here

# OpenRouter Model Selection Strategy (Free-First Hierarchy)
# Primary model: Prioritize high-capability free-tier models on OpenRouter
# Fallback models: Comma-separated list of secondary models if primary fails
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,liquid/lfm-2.5-2.6b:free

# OpenRouter Request Metadata (Recommended for rate limits & tracking)
OPENROUTER_SITE_URL=http://localhost:5678
OPENROUTER_APP_NAME=n8n-workflow-ai-generator

# ------------------------------------------------------------------------------
# Optional Fallback LLM Provider: Groq
# Groq is optional. Leave GROQ_API_KEY blank if not using Groq fallback.
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here_or_leave_blank
GROQ_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# LLM Request, Retry & Timeout Settings
# ------------------------------------------------------------------------------
LLM_REQUEST_TIMEOUT=30.0
LLM_MAX_RETRIES=3
LLM_BASE_BACKOFF_SEC=1.0

# ------------------------------------------------------------------------------
# Web Research & Technical Documentation Provider: Tavily
# Leave TAVILY_API_KEY blank if research is not needed or when testing offline.
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here_or_leave_blank
TAVILY_BASE_URL=https://api.tavily.com
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT_SEC=15.0
TAVILY_MAX_RETRIES=2
TAVILY_CACHE_TTL_HOURS=24
TAVILY_MAX_RESEARCH_PER_TURN=3
TAVILY_MAX_EXTRACT_PER_TURN=3
TAVILY_MAX_CONTENT_CHARS=6000

# ------------------------------------------------------------------------------
# Local Infrastructure & n8n Service Configuration (Free & Self-Hosted)
# ------------------------------------------------------------------------------
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=

# Database Configuration (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/n8n_workflow_ai

# Backend App Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
